        color: #fff;
    }

    .ig-custom-close-btn {
        background: none;
        border: none;
        color: var(--ig-text-muted);
        font-size: 16px;
        cursor: pointer;
    }

    .ig-custom-input-wrapper {
        display: flex;
        align-items: center;
        background: #121212;
        border-radius: 10px;
        padding: 10px 14px;
        gap: 10px;
    }

    .ig-custom-search-input {
        width: 100%;
        background: transparent;
        border: none;
        font-size: 14px;
        color: #fff;
        outline: none;
    }

    .ig-custom-modal-results {
