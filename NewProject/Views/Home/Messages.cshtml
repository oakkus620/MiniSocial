        color: #ffffff !important;
        cursor: pointer;
    }

    .ig-chat-menu-item.delete {
        color: #ed4956 !important;
    }

    .ig-chat-menu-item:hover {
        background: rgba(255,255,255,0.08) !important;
    }

    .ig-dm-chat-area {
        flex: 1;
        display: flex;
        flex-direction: column;
        background: var(--ig-bg);
        height: 100vh;
        box-sizing: border-box;
    }

    .ig-dm-empty-state {
        margin: auto;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
    }

    .ig-empty-plane-icon {
        width: 96px;
        height: 96px;
        border: 2px solid var(--ig-text);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 36px;
        color: var(--ig-text);
