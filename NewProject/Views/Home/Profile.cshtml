@using YourProject.Models
@inject NewProject.Data.AppDbContext _context
@model IEnumerable<PostModels>
@{
    ViewData["Title"] = ViewBag.ProfileUsername + " • Profil";
    string currentUsername = Context.Session.GetString("GirisYapanKullanici") ?? string.Empty;

    bool isMyProfile = ViewBag.IsMyProfile != null && (bool)ViewBag.IsMyProfile;
    bool isFollowing = ViewBag.IsFollowing != null && (bool)ViewBag.IsFollowing;
    bool hasPendingRequest = ViewBag.HasPendingRequest != null && (bool)ViewBag.HasPendingRequest;
    bool canSeePosts = ViewBag.CanSeePosts != null && (bool)ViewBag.CanSeePosts;

    var profileStoriesList = ViewBag.ProfileStoriesList as List<Story> ?? new List<Story>();
    bool hasProfileStory = profileStoriesList.Any();

    // DÜZELTME: Hesap gizli ise VE kendi profilimiz değilse VE takip etmiyorsak hikaye halkası görünmesin!
    var profileUserObj = ViewBag.ProfileUser;
    bool isTargetPrivate = profileUserObj != null && profileUserObj.IsPrivate;
    bool canSeeStory = isMyProfile || !isTargetPrivate || isFollowing;

    bool hasValidStory = hasProfileStory && canSeeStory;
    string profileRingClass = hasValidStory ? "has-story" : "";

    var seenList = ViewBag.SeenStoryIds as List<int> ?? new List<int>();
    bool isProfileStoriesAllSeen = hasValidStory && profileStoriesList.All(s => seenList.Contains(s.Id));
    if (isProfileStoriesAllSeen) { profileRingClass = "seen-story"; }
}

<!-- ARAMA MODALI -->
<div id="searchModalOverlay" class="ig-search-overlay" style="display: none;" onclick="closeSearchModalOnOutside(event)">
    <div class="ig-search-modal-box" onclick="event.stopPropagation()">
        <div class="ig-search-modal-header">
            <h3>Arama Yap</h3>
            <button type="button" onclick="toggleSearchModal()" class="ig-search-close-btn">✕</button>
        </div>
        <div class="ig-search-input-wrapper">
            <input type="text" id="searchInput" class="ig-modal-search-input" placeholder="Hesap ara..." oninput="searchUsersAjax(this.value)" autocomplete="off" autofocus />
        </div>
        <div class="ig-search-modal-results" id="searchResultsContainer">
            <div class="ig-search-placeholder">Aramak için bir şeyler yazın...</div>
        </div>
    </div>
</div>

<!-- HİKAYE SEÇİM MODALI -->
<div id="storyCreateModal" class="ig-story-create-modal" style="display: none;" onclick="closeStoryCreateModal(event)">
    <div class="ig-story-create-box" onclick="event.stopPropagation()">
        <div class="ig-story-create-header">
            <h3>Hikaye Ekle</h3>
            <button type="button" onclick="closeStoryCreateModal()" class="ig-search-close-btn">✕</button>
        </div>
        <div class="ig-story-create-options">
            <button type="button" class="ig-story-option-btn" onclick="document.getElementById('profileStoryInput').click()">
                <i class="fa-solid fa-photo-film"></i>
                <span>Fotoğraf / Video Yükle</span>
            </button>
        </div>
    </div>
</div>

<!-- HİKAYE ÖNİZLEME MODALI -->
<div id="storyPreviewModal" class="ig-story-preview-overlay-fixed" style="display: none;" onclick="closeStoryPreview(event)">
    <div class="ig-story-preview-box-fixed" onclick="event.stopPropagation()">
        <div class="ig-story-create-header">
            <h3>Hikayeyi Önizle</h3>
            <button type="button" onclick="closeStoryPreview()" class="ig-search-close-btn">✕</button>
        </div>
        <div class="ig-story-preview-media" id="storyPreviewMediaContainer"></div>
        <div class="ig-story-preview-footer">
            <button type="button" class="ig-story-cancel-btn" onclick="closeStoryPreview()">İptal</button>
            <button type="button" class="ig-story-share-submit-btn" onclick="document.getElementById('realStoryForm').submit()">Hikayende Paylaş</button>
        </div>
    </div>
</div>

<form asp-action="CreateStory" method="post" enctype="multipart/form-data" id="realStoryForm" style="display:none;">
    <input type="file" id="hiddenStoryFileInput" name="storyMedia" accept="image/*,video/*" />
</form>

<div class="ig-layout">
    <nav class="ig-sidebar">
        <div class="ig-logo-area"><i class="fa-solid fa-globe ig-logo-icon"></i></div>
        <ul class="ig-nav-list">
            <li><a href="/Home/Index" class="ig-nav-item"><i class="fa-solid fa-house"></i> <span class="ig-nav-label">Ana Sayfa</span></a></li>
            <li><a href="#" class="ig-nav-item"><i class="fa-solid fa-compass"></i> <span class="ig-nav-label">Keşfet</span></a></li>
            <li>
                <button type="button" class="ig-nav-item" onclick="toggleSearchModal(event)" style="background:none; border:none; width:100%; text-align:left; cursor:pointer; padding: 12px 10px; color: inherit; font: inherit; display:flex; align-items:center; gap:16px;">
                    <i class="fa-solid fa-magnifying-glass"></i> <span class="ig-nav-label">Ara</span>
                </button>
            </li>
            <li><a href="#" class="ig-nav-item"><i class="fa-solid fa-clapperboard"></i> <span class="ig-nav-label">Reels</span></a></li>
            <li>
                <a href="/Home/Notifications" class="ig-nav-item" style="position: relative;">
                    <i class="fa-regular fa-heart"></i> <span class="ig-nav-label">Bildirimler</span>
                    @if (ViewBag.HasUnreadNotifications != null && (bool)ViewBag.HasUnreadNotifications)
                    {
                        <span style="position: absolute; top: 14px; left: 24px; width: 7px; height: 7px; background: #ed4956; border-radius: 50%;"></span>
                    }
                </a>
            </li>
            <li><a href="/Home/Profile/@currentUsername" class="ig-nav-item active"><img src="@(ViewBag.ActiveUser != null && !string.IsNullOrEmpty(ViewBag.ActiveUser.ProfilePicturePath) ? ViewBag.ActiveUser.ProfilePicturePath : "https://cdn-icons-png.flaticon.com/512/149/149071.png")" class="ig-nav-avatar" /> <span class="ig-nav-label">Profil</span></a></li>
        </ul>
        <div class="ig-sidebar-bottom">
            <button type="button" class="ig-bottom-item" onclick="toggleTheme()">
                <i class="fa-solid fa-moon" id="themeIcon"></i> 
                <span class="ig-nav-label" id="themeText">Tema: Koyu</span>
            </button>
            <button type="button" class="ig-bottom-item" onclick="openLogoutModal()">
                <i class="fa-solid fa-right-from-bracket"></i>
                <span class="ig-nav-label">Çıkış Yap</span>
            </button>
        </div>
    </nav>

    <main class="ig-profile-main">
        <header class="ig-profile-header">
            <div class="ig-profile-avatar-outer @profileRingClass" id="ring-profile-main" style="cursor: pointer; position: relative;">
                <div class="ig-profile-avatar-container" onclick="@(hasProfileStory ? $"openUserStories('{ViewBag.ProfileUsername}')" : (isMyProfile ? "document.getElementById('storyCreateModal').style.display = 'flex'" : ""))">
                    <img src="@ViewBag.ProfileUserPic" alt="Profil" class="ig-profile-big-avatar" />
                </div>
                @if (isMyProfile)
                {
                    <div class="ig-profile-story-add-badge" onclick="document.getElementById('storyCreateModal').style.display = 'flex'" title="Hikaye Ekle"><i class="fa-solid fa-plus"></i></div>
                }
            </div>

            @if (isMyProfile)
            {
                <input type="file" id="profileStoryInput" name="storyMedia" accept="image/*,video/*" style="display:none;" onchange="handleStoryFileSelect(event)" />
            }

            <div class="ig-profile-info-section">
                <div class="ig-profile-top-row">
                    <h2 class="ig-profile-username-title">@ViewBag.ProfileUsername</h2>
                </div>
                <div class="ig-profile-stats-row">
                    <span><strong>@ViewBag.PostCount</strong> gönderi</span>
                    <span onclick="openFollowModal('@ViewBag.ProfileUsername', 'followers')" style="cursor: pointer;"><strong><span id="followerCountDisplay">@ViewBag.FollowersCount</span></strong> takipçi</span>
                    <span onclick="openFollowModal('@ViewBag.ProfileUsername', 'following')" style="cursor: pointer;"><strong>@ViewBag.FollowingCount</strong> takip edilen</span>
                </div>
                <div class="ig-profile-bio-section">
                    <span class="ig-profile-fullname">@ViewBag.ProfileUsername</span>
                    <p class="ig-profile-biotext">@ViewBag.ProfileUserBio</p>
                </div>
                <div class="ig-profile-actions-row">
                    @if (isMyProfile)
                    {
                        <button type="button" onclick="openEditModal()" class="ig-edit-profile-btn" style="background: var(--ig-border); color: var(--ig-text); border: none; cursor: pointer;">Profili düzenle</button>
                        <a href="#" class="ig-edit-profile-btn">Arşivi gör</a>
                    }
                    else if (ViewBag.HasIncomingRequest != null && (bool)ViewBag.HasIncomingRequest)
                    {
                        <!-- BU KİŞİ SANA İSTEK ATMIŞSA "ONAYLA" VE "SİL" ÇIKSIN -->
                        <button onclick="respondRequest(@ViewBag.IncomingRequestId, 'accept')" style="background: #0095f6; color: white; border: none; padding: 7px 20px; border-radius: 8px; font-weight: 600; cursor: pointer;">Onayla</button>
                        <button onclick="respondRequest(@ViewBag.IncomingRequestId, 'reject')" style="background: #262626; color: white; border: none; padding: 7px 20px; border-radius: 8px; font-weight: 600; cursor: pointer;">Sil</button>
                    }
                    else
                    {
                        <button type="button" id="followBtn" class="ig-follow-main-btn @(isFollowing ? "following" : "")" onclick="toggleFollow('@ViewBag.ProfileUsername')">
                            @(isFollowing ? "Takipten Çık" : "Takip Et")
                        </button>
                        <button type="button" class="ig-message-btn-wide">Mesaj Gönder</button>
                    }
                </div>
            </div>
        </header>

        <!-- INSTAGRAM TARZI 3'LÜ SEKME ÇUBUĞU -->
        <div class="ig-profile-tabs-bar">
            <div class="ig-profile-tab-item active">
                <i class="fa-solid fa-table-cells"></i> <span>GÖNDERİLER</span>
            </div>
            <div class="ig-profile-tab-item">
                <i class="fa-regular fa-bookmark"></i> <span>KAYDEDİLENLER</span>
            </div>
            <div class="ig-profile-tab-item">
                <i class="fa-regular fa-id-badge"></i> <span>ETİKETLENENLER</span>
            </div>
        </div>

        @if (canSeePosts)
        {
            <div class="ig-user-posts-grid">
                @if (Model == null || !Model.Any())
                {
                    <div class="ig-no-posts-box">
                        <div class="ig-empty-camera-icon"><i class="fa-solid fa-camera"></i></div>
                        <h3>Gönderi Yok</h3>
                        <p>Henüz bir gönderi paylaşılmadı.</p>
                    </div>
                }
                else
                {
                    @foreach (var post in Model)
                    {
                        <div class="ig-grid-post-card" onclick="openPostModal(@post.Id)" style="cursor: pointer; position: relative;">
                            @if (!string.IsNullOrEmpty(post.MediaUrl))
                            {
                                <div class="ig-grid-media" style="width: 100%; height: 100%; position: relative;">
                                    @if (post.MediaType == "video")
                                    {
                                        <video src="@post.MediaUrl" style="width: 100%; height: 100%; object-fit: cover;"></video>
                                    }
                                    else
                                    {
                                        <img src="@post.MediaUrl" alt="Post" style="width: 100%; height: 100%; object-fit: cover;" />
                                    }
                                    <!-- HOVER (ÜZERİNE GELİNCE ÇIKAN BEĞENİ VE YORUM SAYISI) -->
                                    <div class="ig-grid-hover-overlay" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.3); display: none; align-items: center; justify-content: center; gap: 24px; color: white; font-weight: 600; font-size: 15px;">
                                        <span><i class="fa-solid fa-heart"></i> @post.Likes.Count</span>
                                        <span><i class="fa-solid fa-comment"></i> @post.Comments.Count</span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="ig-grid-text-only" style="padding: 16px; font-size: 13px; color: var(--ig-text); height: 100%; box-sizing: border-box; display: flex; align-items: center; justify-content: center; text-align: center;">
                                    <p>@post.Content</p>
                                </div>
                            }
                        </div>
                    }
                }
                
            </div>
        }
        else
        {
            <!-- HESAP GİZLİ VE TAKİP EDİLMİYORSA -->
            <div class="ig-private-account-box" style="text-align: center; padding: 60px 20px; color: var(--ig-text-muted);">
                <i class="fa-solid fa-lock fa-3x mb-3" style="margin-bottom: 15px; display: block;"></i>
                <h3 style="font-size: 18px; color: var(--ig-text); margin-bottom: 8px;">Bu Hesap Gizli</h3>
                <p style="font-size: 14px; margin: 0;">Bu hesabın fotoğraf ve videolarını görmek için takip etmelisin.</p>
            </div>
        }
    </main>
</div>

<!-- HİKAYE OYNATICISI -->
<div id="storyViewerModal" class="ig-story-viewer-modal" onclick="closeStoryViewer()">
    <div class="ig-story-backdrop-blur"></div>
    <div class="ig-story-top-bar" onclick="event.stopPropagation()">
        <div class="ig-story-progress-container" id="storyProgressContainer"></div>
        <div class="ig-story-header-info">
            <img id="viewerOwnerPic" src="" class="ig-viewer-avatar" />
            <span id="viewerOwnerName" class="ig-viewer-username"></span>
            <span id="viewerTimeAgo" class="ig-viewer-time"></span>
        </div>
        <div class="ig-story-header-right">
            <div class="ig-story-menu-wrapper">
                <button type="button" class="ig-story-dots-btn" onclick="toggleStoryMenu(event)"><span></span><span></span><span></span></button>
                <div id="storyDropdownMenu" class="ig-story-dropdown" style="display:none;">
                    <a id="deleteStoryLink" href="#" class="ig-story-delete-item">Hikayeyi Sil</a>
                </div>
            </div>
            <button type="button" class="ig-story-close-global" onclick="closeStoryViewer()">✕</button>
        </div>
    </div>
    <div class="ig-story-viewer-container" onclick="event.stopPropagation()">
        <div class="ig-main-story-card">
            <div class="ig-story-media-box" id="viewerMediaContainer"
                 onmousedown="startStoryHold(event)" onmouseup="endStoryHold(event)" onmouseleave="endStoryHold(event)"
                 onttouchstart="startStoryHold(event)" ontouchend="endStoryHold(event)" onclick="handleStoryCardClick(event)">
            </div>
            <div class="ig-story-footer-actions">
                <input type="text" id="storyCommentInput" placeholder="Yanıt gönder..." autocomplete="off" onkeypress="handleStoryComment(event)" />
                <button type="button" class="ig-story-like-btn" onclick="likeActiveStory()"><i class="fa-regular fa-heart" id="storyHeartIcon"></i></button>
                <button type="button" class="ig-story-send-btn" onclick="sendStoryComment()"><i class="fa-regular fa-paper-plane"></i></button>
            </div>
        </div>
    </div>
</div>

<!-- ÇIKIŞ ONAY MODALI -->
<div id="logoutModal" class="ig-logout-modal-overlay" style="display: none;" onclick="closeLogoutModalOnOutside(event)">
    <div class="ig-logout-modal-box">
        <div class="ig-logout-modal-header">
            <h3>Çıkış Yap</h3>
            <p>Hesabınızdan çıkış yapmak istediğinize emin misiniz?</p>
        </div>
        <div class="ig-logout-modal-actions">
            <a href="/Account/Logout" class="ig-logout-confirm-btn">Çıkış Yap</a>
            <button type="button" class="ig-logout-cancel-btn" onclick="closeLogoutModal()">İptal</button>
        </div>
    </div>
</div>


<!-- PROFİLİ DÜZENLE MODALI -->
<div id="editProfileModal" class="ig-logout-modal-overlay" style="display: none;" onclick="closeEditModalOnOutside(event)">
    <div class="ig-logout-modal-box" style="width: 400px; padding: 20px; text-align: left;">
        <div class="ig-search-modal-header" style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--ig-border); padding-bottom: 10px; margin-bottom: 15px;">
            <h3 style="margin: 0; font-size: 16px;">Profili Düzenle</h3>
            <button type="button" onclick="closeEditModal()" class="ig-search-close-btn">✕</button>
        </div>
        <form asp-action="UpdateProfile" method="post" enctype="multipart/form-data">
            <div style="margin-bottom: 15px;">
                <label style="font-size: 13px; font-weight: 600; display: block; margin-bottom: 5px;">Biyografi</label>
                <textarea name="bio" class="ig-modal-search-input" style="height: 80px; resize: none;">@ViewBag.ProfileUserBio</textarea>
            </div>
            <div style="margin-bottom: 15px;">
                <label style="font-size: 13px; font-weight: 600; display: block; margin-bottom: 5px;">Profil Fotoğrafı Seç</label>
                <input type="file" name="profilePicture" accept="image/*" style="color: #fff; font-size: 13px;" />
            </div>
            <div style="margin-bottom: 20px; display: flex; align-items: center; gap: 10px;">
                <input type="checkbox" id="isPrivateCheckbox" name="isPrivate" value="true" @(ViewBag.ProfileUser != null && ViewBag.ProfileUser.IsPrivate ? "checked" : "") style="width: 18px; height: 18px; cursor: pointer;" />
                <label for="isPrivateCheckbox" style="font-size: 14px; cursor: pointer; font-weight: 500;">Hesabım Gizli</label>
            </div>
            <button type="submit" style="width: 100%; background: var(--ig-primary); color: white; border: none; padding: 10px; border-radius: 8px; font-weight: 600; cursor: pointer;">Değişiklikleri Kaydet</button>
        </form>
    </div>
</div>

<!-- TAKİPÇİ / TAKİP EDİLEN LİSTESİ MODALI -->
<div id="followListModal" class="ig-logout-modal-overlay" style="display: none;" onclick="closeFollowModalOnOutside(event)">
    <div class="ig-logout-modal-box" style="width: 400px; height: 450px; background: #262626; display: flex; flex-direction: column; overflow: hidden; border-radius: 14px;">
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 14px 16px; border-bottom: 1px solid #363636;">
            <h3 id="followModalTitle" style="margin: 0; font-size: 15px; color: #fff;">Takipçiler</h3>
            <button type="button" onclick="closeFollowModal()" style="background: none; border: none; color: #737373; font-size: 16px; cursor: pointer;">✕</button>
        </div>
        <div id="followModalResults" style="flex: 1; overflow-y: auto; padding: 12px; display: flex; flex-direction: column; gap: 8px;">
            <!-- Dinamik liste buraya gelecek -->
        </div>
    </div>
</div>

<!-- GÖNDERİ DETAY (LIGHTBOX) MODALI -->
<div id="postDetailModal" class="ig-logout-modal-overlay" style="display: none; align-items: center; justify-content: center; background: rgba(0,0,0,0.85); z-index: 9999999;" onclick="closePostModalOnOutside(event)">
    <button type="button" onclick="closePostModal()" style="position: absolute; top: 20px; right: 20px; background: none; border: none; color: white; font-size: 28px; cursor: pointer; z-index: 10000;">✕</button>
    <div id="postModalContentBox" style="background: #000; border: 1px solid #262626; border-radius: 4px; overflow: hidden; display: flex; max-width: 1000px; width: 90vw; max-height: 90vh; box-shadow: 0 10px 30px rgba(0,0,0,0.8);" onclick="event.stopPropagation()">
        <!-- İçerik AJAX ile yüklenecek -->
    </div>
</div>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    :root {
        --ig-bg: #000;
        --ig-card-bg: #000;
        --ig-text: #fff;
        --ig-text-muted: #737373;
        --ig-border: #262626;
        --ig-input-bg: #121212;
        --ig-hover: rgba(255, 255, 255, 0.05);
        --ig-primary: #0095f6;
    }

    body {
        background-color: var(--ig-bg);
        color: var(--ig-text);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        margin: 0;
        padding: 0;
    }

    .ig-layout {
        display: flex;
        max-width: 1200px;
        margin: 0 auto;
        min-height: 100vh;
        justify-content: center;
        position: relative;
    }

    .ig-search-overlay, .ig-story-create-modal, .ig-logout-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 999999;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(0,0,0,0.8);
        backdrop-filter: blur(4px);
    }

    .ig-story-preview-overlay-fixed {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        background: rgba(0,0,0,0.85) !important;
        backdrop-filter: blur(5px);
        z-index: 999999999 !important;
        display: none;
        align-items: center !important;
        justify-content: center !important;
    }

    .ig-story-preview-box-fixed {
        width: 380px !important;
        max-width: 90vw !important;
        background: #262626 !important;
        border-radius: 14px !important;
        overflow: hidden !important;
        display: flex !important;
        flex-direction: column !important;
        box-shadow: 0 15px 50px rgba(0,0,0,0.9) !important;
        border: 1px solid #363636 !important;
    }

    .ig-story-preview-media {
        padding: 15px;
        text-align: center;
        background: #121212;
        max-height: 350px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .ig-story-preview-media img, .ig-story-preview-media video {
        max-width: 100%;
        max-height: 320px;
        border-radius: 8px;
        object-fit: contain;
    }

    .ig-story-preview-footer {
        padding: 14px 20px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        background: #262626;
        border-top: 1px solid #363636;
    }

    .ig-story-cancel-btn {
        background: none;
        border: none;
        color: var(--ig-text);
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        padding: 8px 14px;
    }

    .ig-story-share-submit-btn {
        background: var(--ig-primary);
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
    }

    .ig-story-viewer-modal {
        position: fixed !important;
        top: 0 !important;
        left: 0 !important;
        width: 100vw !important;
        height: 100vh !important;
        background: rgba(0, 0, 0, 0.9) !important;
        z-index: 99999999 !important;
        display: none;
        align-items: center !important;
        justify-content: center !important;
    }

    .ig-story-viewer-container {
        position: relative !important;
        width: 100% !important;
        max-width: 400px !important;
        height: 85vh !important;
        max-height: 750px !important;
        margin: auto !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        z-index: 5 !important;
    }

    .ig-main-story-card {
        width: 100% !important;
        height: 100% !important;
        background: #000 !important;
        border-radius: 12px !important;
        overflow: hidden !important;
        display: flex !important;
        flex-direction: column !important;
        position: relative !important;
        box-shadow: 0 10px 40px rgba(0,0,0,0.9) !important;
    }

    .ig-story-media-box {
        flex: 1 !important;
        width: 100% !important;
        height: 100% !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        background: #111 !important;
        overflow: hidden !important;
