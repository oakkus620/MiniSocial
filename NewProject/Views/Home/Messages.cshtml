    }

    .ig-msg-action-item:hover {
        background: rgba(255,255,255,0.08) !important;
    }

    .ig-msg-sender-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        object-fit: cover;
        align-self: flex-end;
        margin-bottom: 2px;
        flex-shrink: 0;
    }
</style>

<script>
    let activeFullScreenUser = null;
    let activeFullScreenPic = "";
    let allConversationsCache = [];
    let draftTimeout = null;

    window.addEventListener('DOMContentLoaded', () => {
        loadFullScreenConversations();
    });

    document.addEventListener('click', function(e) {
        if (!e.target.closest('.ig-msg-options-trigger') && !e.target.closest('.ig-msg-action-menu')) {
            document.querySelectorAll('.ig-msg-action-menu').forEach(m => {
                m.style.display = 'none';
            });
        }
        if (!e.target.closest('.ig-chat-dots-btn') && !e.target.closest('.ig-chat-popup-menu')) {
            document.querySelectorAll('.ig-chat-popup-menu').forEach(m => {
                m.style.display = 'none';
            });
        }
    }, true);

    function toggleNewChatModal() {
        const modal = document.getElementById('newChatModal');
        if (!modal) return;
        const isOpen = modal.style.display === 'flex';
        modal.style.display = isOpen ? 'none' : 'flex';
        if (!isOpen) {
            document.getElementById('newChatSearchInput').value = '';
            document.getElementById('newChatSearchResults').innerHTML = '<div class="ig-search-placeholder">Mesaj göndermek istediğiniz kişiyi arayın...</div>';
            setTimeout(() => document.getElementById('newChatSearchInput').focus(), 100);
        }
    }

    function closeNewChatModalOnOutside(e) {
        const modal = document.getElementById('newChatModal');
        if (e.target === modal) modal.style.display = 'none';
    }

    function searchUsersForNewChat(query) {
        const container = document.getElementById('newChatSearchResults');
        if (!query || query.trim() === "") {
            container.innerHTML = '<div class="ig-search-placeholder">Mesaj göndermek istediğiniz kişiyi arayın...</div>';
            return;
        }
        fetch('/Home/SearchAllUsers?q=' + encodeURIComponent(query))
            .then(res => res.json())
            .then(users => {
                if (!users || users.length === 0) {
                    container.innerHTML = '<div class="ig-search-placeholder">Kullanıcı bulunamadı.</div>';
                    return;
                }
                let html = '';
                users.forEach(u => {
                    html += `
                            <div class="ig-search-result-item" onclick="selectUserForChat('${u.username}', '${u.profilePicture}')" style="display:flex; align-items:center; gap:12px; padding:10px 12px; border-radius:8px; cursor:pointer;">
                                <img src="${u.profilePicture}" style="width:44px; height:44px; border-radius:50%; object-fit:cover;" />
                                <div>
                                    <span style="font-weight:600; font-size:14px; color:var(--ig-text); display:block;">${u.username}</span>
                                    <span style="font-size:12px; color:var(--ig-text-muted);">${u.bio || ''}</span>
                                </div>
                            </div>`;
                });
                container.innerHTML = html;
            });
    }

    function selectUserForChat(username, profilePic) {
        toggleNewChatModal();
        openFullScreenChat(username, profilePic);
    }

    function loadFullScreenConversations() {
        fetch('/Home/GetConversations')
            .then(res => res.json())
            .then(response => {
                allConversationsCache = response.conversations;
                renderConversationsList(allConversationsCache);
            });
    }

    function filterConversations(query) {
        if (!query || query.trim() === "") {
            renderConversationsList(allConversationsCache);
            return;
        }
        const filtered = allConversationsCache.filter(c => c.username.toLowerCase().includes(query.toLowerCase()));
        renderConversationsList(filtered);
    }

    function renderConversationsList(data) {
        const container = document.getElementById('fullScreenChatList');
        if (!data || data.length === 0) {
            container.innerHTML = '<div style="text-align:center; color:var(--ig-text-muted); margin-top:40px; font-size:13px;">Sohbet bulunamadı.</div>';
            return;
        }
        let html = '';
        data.forEach(conv => {
            let activeClass = (activeFullScreenUser === conv.username) ? 'active-chat' : '';
            let previewText = "";
            if (conv.hasDraft) {
                previewText = `<span style="color:#ed4956; font-weight:600;">Taslak: ${conv.draftContent}</span>`;
            } else if (conv.isMuted) {
                previewText = '<i class="fa-solid fa-bell-slash" style="font-size:11px; margin-right:4px;"></i> Sessize alındı';
            } else {
                previewText = `${conv.lastMessage} · ${conv.timeAgo}`;
            }

            let muteUnmuteText = conv.isMuted ? "Sessizden çıkar" : "Sessize al";
            let muteActionType = conv.isMuted ? "unmute" : "mute";

            html += `
                    <div class="ig-chat-row ${conv.isRead || conv.hasDraft ? '' : 'unread'} ${activeClass}" onclick="openFullScreenChat('${conv.username}', '${conv.profilePicture}')">
                        <div class="ig-chat-user-info" style="display:flex; align-items:center; gap:12px; width:100%; overflow:hidden;">
                            <img src="${conv.profilePicture}" class="ig-chat-avatar" style="width:56px; height:56px; border-radius:50%; object-fit:cover; flex-shrink:0;" />
                            <div class="ig-chat-details" style="display:flex; flex-direction:column; overflow:hidden;">
                                <span class="ig-chat-name" style="font-size:14px; color:var(--ig-text);">${conv.username}</span>
                                <span class="ig-chat-preview" style="font-size:13px; color:var(--ig-text-muted); white-space:nowrap; overflow:hidden; text-overflow:ellipsis;">${previewText}</span>
                            </div>
                        </div>
                        ${!conv.isRead && !conv.hasDraft ? '<div class="ig-unread-dot" style="width:8px; height:8px; background:var(--ig-primary); border-radius:50%; flex-shrink:0; margin-left:8px;"></div>' : ''}
                        <div class="ig-chat-options-wrapper" onclick="event.stopPropagation()">
                            <button type="button" class="ig-chat-dots-btn" onclick="toggleChatMenu(event, '${conv.username}')">
                                <i class="fa-solid fa-ellipsis"></i>
                            </button>
                            <div id="chat-menu-${conv.username}" class="ig-chat-popup-menu">
                                <button type="button" class="ig-chat-menu-item" onclick="updateMessageAction('${conv.username}', 'read')">Görüldü olarak işaretle</button>
                                <button type="button" class="ig-chat-menu-item" onclick="updateMessageAction('${conv.username}', '${muteActionType}')">${muteUnmuteText}</button>
                                <button type="button" class="ig-chat-menu-item delete" onclick="updateMessageAction('${conv.username}', 'delete')">Sil</button>
                            </div>
                        </div>
                    </div>`;
        });
        container.innerHTML = html;
    }

    function toggleChatMenu(event, username) {
        event.stopPropagation();
        document.querySelectorAll('.ig-chat-popup-menu').forEach(m => m.style.display = 'none');
        const menu = document.getElementById(`chat-menu-${username}`);
        if (menu) {
            menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
        }
    }

    function updateMessageAction(username, actionType) {
        fetch('/Home/UpdateMessageAction?partnerUsername=' + encodeURIComponent(username) + '&actionType=' + actionType, {
            method: 'POST'
        })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    loadFullScreenConversations();
                    if (activeFullScreenUser === username) {
                        openFullScreenChat(activeFullScreenUser, activeFullScreenPic);
                    }
                }
            });
    }

    function openFullScreenChat(username, profilePic) {
        activeFullScreenUser = username;
        activeFullScreenPic = profilePic;

        fetch('/Home/MarkConversationAsRead?partnerUsername=' + encodeURIComponent(username), { method: 'POST' })
            .then(() => loadFullScreenConversations());

        fetch('/Home/GetChatMessages?partnerUsername=' + encodeURIComponent(username))
            .then(res => res.json())
            .then(data => {
                const area = document.getElementById('fullScreenChatArea');
                let msgsHtml = `
                        <div class="ig-active-dm-box">
                            <div class="ig-active-dm-header">
                                <a href="/Home/Profile/${encodeURIComponent(username)}" class="ig-active-dm-user-info" style="text-decoration:none;">
                                    <img src="${profilePic}" class="ig-active-dm-avatar" />
                                    <span style="font-weight:600; font-size:16px; color:var(--ig-text);">${username}</span>
                                </a>
                                <div style="display:flex; gap:20px; color:var(--ig-text); font-size:20px; cursor:pointer;">
                                    <i class="fa-solid fa-phone"></i>
                                    <i class="fa-solid fa-video"></i>
                                    <i class="fa-solid fa-circle-info"></i>
                                </div>
                            </div>
                            <div class="ig-active-dm-messages-body" id="fsChatScroll">`;

                data.messages.forEach(m => {
                    let senderVal = m.sender || m.SenderUsername || m.Sender || m.username || m.Username || "";
                    let isOutgoing = senderVal.trim().toLowerCase() === "@currentUsername".toLowerCase();

                    let bubbleClass = isOutgoing ? "outgoing" : "incoming";
                    let wrapClass = isOutgoing ? "outgoing-wrap" : "incoming-wrap";

                    let menuItems = `<button type="button" class="ig-msg-action-item delete" onclick="deleteFullScreenMessage('${m.id}', 'self')">Benden sil</button>`;
                    if (isOutgoing) {
                        menuItems += `<button type="button" class="ig-msg-action-item delete" onclick="deleteFullScreenMessage('${m.id}', 'everyone')">İki taraftan da sil</button>`;
                    }

                    let incomingAvatarHtml = !isOutgoing ? `
                            <a href="/Home/Profile/${encodeURIComponent(username)}" style="flex-shrink:0;">
                                <img src="${profilePic}" class="ig-msg-sender-avatar" />
                            </a>` : '';

                    let rawDate = m.date || m.Date || m.createdAt || m.CreatedAt || m.timestamp || m.Timestamp;

                    msgsHtml += `
                            <div class="ig-msg-bubble-wrapper ${wrapClass}">
                                <div class="ig-bubble-row-inner">
                                    ${incomingAvatarHtml}
                                    <div class="ig-bubble ${bubbleClass}">
                                        ${m.content}
                                        <span class="ig-msg-time">${formatMessageTime(rawDate)}</span>
                                    </div>
                                    <button type="button" class="ig-msg-options-trigger" onclick="toggleFullScreenMenu(event, '${m.id}')">
                                        <i class="fa-solid fa-ellipsis"></i>
                                    </button>
                                </div>
                                <div id="fs-msg-menu-${m.id}" class="ig-msg-action-menu" onclick="event.stopPropagation()">
                                    ${menuItems}
                                </div>
                            </div>`;
                });

                let draftVal = data.draft || "";
                msgsHtml += `
                            </div>
                            <div class="ig-active-dm-input-box">
                                <div class="ig-active-dm-input-wrapper">
                                    <i class="fa-regular fa-face-smile" style="color:var(--ig-text); font-size:20px; cursor:pointer;"></i>
                                    <input type="text" id="fsChatInput" class="ig-active-dm-input" placeholder="Mesaj gönder..." value="${draftVal}" oninput="handleDraftInput(this.value)" onkeypress="handleFSKey(event, '${username}')" autocomplete="off" spellcheck="false" autofocus />
                                    <button type="button" class="ig-active-dm-send-btn" onclick="sendFullScreenMessage('${username}')">Gönder</button>
                                    <i class="fa-regular fa-image" style="color:var(--ig-text); font-size:20px; cursor:pointer;"></i>
                                    <i class="fa-regular fa-thumbs-up" style="color:var(--ig-text); font-size:20px; cursor:pointer;"></i>
                                </div>
                            </div>
                        </div>`;

                area.innerHTML = msgsHtml;
                const scrollBox = document.getElementById('fsChatScroll');
                if (scrollBox) scrollBox.scrollTop = scrollBox.scrollHeight;
            });
    }

    function toggleFullScreenMenu(event, msgId) {
        event.stopPropagation();
        const menu = document.getElementById(`fs-msg-menu-${msgId}`);
        if (!menu) return;

        document.querySelectorAll('.ig-msg-action-menu').forEach(m => {
            if (m.id !== `fs-msg-menu-${msgId}`) m.style.display = 'none';
        });

        menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
    }

    function deleteFullScreenMessage(msgId, deleteType) {
        fetch('/Home/DeleteSingleMessage', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `messageId=${msgId}&deleteType=${deleteType}`
        })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    openFullScreenChat(activeFullScreenUser, activeFullScreenPic);
                    loadFullScreenConversations();
                }
            });
    }

    function handleDraftInput(val) {
        clearTimeout(draftTimeout);
        draftTimeout = setTimeout(() => {
            if (!activeFullScreenUser) return;
            fetch('/Home/SaveDraft', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `receiverUsername=${encodeURIComponent(activeFullScreenUser)}&content=${encodeURIComponent(val)}`
            });
        }, 500);
    }

    function sendFullScreenMessage(username) {
        const input = document.getElementById('fsChatInput');
        if (!input || !input.value.trim()) return;
        const text = input.value.trim();

        fetch('/Home/SaveDraft', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: `receiverUsername=${encodeURIComponent(username)}&content=`
        }).then(() => {
            return fetch('/Home/SendMessage', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: `receiverUsername=${encodeURIComponent(username)}&content=${encodeURIComponent(text)}`
            });
        })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    input.value = '';
                    openFullScreenChat(username, activeFullScreenPic);
                    loadFullScreenConversations();
                }
            });
    }

    function handleFSKey(e, username) {
        if (e.key === 'Enter') {
            e.preventDefault();
            sendFullScreenMessage(username);
        }
    }

    function formatMessageTime(dateString) {
        if (!dateString) return "";
        const date = new Date(dateString);
        if (isNaN(date.getTime())) return "";
        return date.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }
</script>
