    }

    .ig-dm-nav-tabs {
        display: flex;
        padding: 0 24px 12px 24px;
        gap: 20px;
        border-bottom: 1px solid var(--ig-border);
    }

    .ig-dm-nav-tabs button {
        background: none;
        border: none;
