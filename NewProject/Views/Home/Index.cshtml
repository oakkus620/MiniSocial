@inject NewProject.Data.AppDbContext _context
@model IEnumerable<PostModels>
@{
    ViewData["Title"] = "Ana Sayfa";
    string currentUsername = Context.Session.GetString("GirisYapanKullanici") ?? string.Empty;
}

<!-- ARKA PLAN KARARTMA PERDESİ -->
<div id="editBackdrop" class="ig-backdrop" onclick="cancelPostEdit()"></div>

<!-- ARAMA MODALI -->
<div id="searchModalOverlay" class="ig-search-overlay" onclick="closeSearchModalOnOutside(event)" style="display: none;">
  <div class="ig-search-modal-box" onclick="event.stopPropagation()">
    <div class="ig-search-modal-header">
      <h3>Arama Yap</h3>
      <button type="button" class="ig-search-close-btn" onclick="toggleSearchModal()">✕</button>
    </div>
    
    <div class="search-bar-container">
      <div class="search-input-wrapper">
        <svg class="search-icon" aria-hidden="true" role="img" viewBox="0 0 24 24" width="16" height="16">
          <path fill="currentColor" d="M19 10.5A8.5 8.5 0 1 1 10.5 2a8.5 8.5 0 0 1 8.5 8.5Z" stroke="currentColor" stroke-width="2" fill="none"></path>
          <line x1="16.511" y1="16.511" x2="22" y2="22" stroke="currentColor" stroke-width="2" stroke-linecap="round"></line>
        </svg>
        <input type="text" id="searchInput" placeholder="Ara..." class="search-input" oninput="searchUsersAjax(this.value)" autocomplete="off" spellcheck="false">
      </div>
    </div>

    <div class="ig-search-modal-results" id="searchResultsContainer">
      <div class="ig-search-placeholder">Aramak için bir şeyler yazın...</div>
    </div>
  </div>
</div>

<!-- HİKAYE SEÇİM MODALI -->
<div id="storyCreateModal" class="ig-story-create-modal" style="display: none;" onclick="closeStoryCreateModal(event)">
    <div class="ig-story-create-box" onclick="event.stopPropagation()">
        <div class="ig-story-create-header">
            <h3>Hikaye Ekle</h3>
            <button type="button" onclick="closeStoryCreateModal()" class="ig-search-close-btn">✕</button>
        </div>
        <div class="ig-story-create-options">
            <button type="button" class="ig-story-option-btn" onclick="document.getElementById('storyFileInput').click()">
                <i class="fa-solid fa-photo-film"></i>
                <span>Fotoğraf / Video Yükle</span>
            </button>
        </div>
    </div>
</div>

<!-- HİKAYE ÖNİZLEME MODALI -->
<div id="storyPreviewModal" class="ig-story-create-modal" style="display: none;" onclick="closeStoryPreview(event)">
    <div class="ig-story-preview-box" onclick="event.stopPropagation()">
        <div class="ig-story-create-header">
            <h3>Hikayeyi Önizle</h3>
            <button type="button" onclick="closeStoryPreview()" class="ig-search-close-btn">✕</button>
        </div>
        <div class="ig-story-preview-media" id="storyPreviewMediaContainer"></div>
        <div class="ig-story-preview-footer">
            <button type="button" class="ig-story-cancel-btn" onclick="closeStoryPreview()">İptal</button>
            <button type="button" class="ig-story-share-submit-btn" onclick="document.getElementById('realStoryForm').submit()">Hikayende Paylaş</button>
        </div>
    </div>
</div>

<form asp-action="CreateStory" method="post" enctype="multipart/form-data" id="realStoryForm" style="display:none;">
    <input type="file" id="hiddenStoryFileInput" name="storyMedia" accept="image/*,video/*" />
</form>

<input type="file" id="storyFileInput" name="storyMedia" accept="image/*,video/*" style="display:none;" onchange="handleStoryFileSelect(event)" />

<!-- DÜZENLEME MODALI -->
<div id="igEditModal" class="ig-edit-modal" style="display: none;">
    <div class="ig-edit-modal-box">
        <div class="ig-edit-modal-header">
            <button type="button" onclick="cancelPostEdit()" class="ig-edit-cancel-btn">İptal</button>
            <span>Gönderiyi Düzenle</span>
            <button type="button" onclick="document.getElementById('realEditForm').submit()" class="ig-edit-done-btn">Paylaş</button>
        </div>
        <div class="ig-edit-modal-body">
            <div class="ig-edit-media-preview" id="modalMediaPreviewSide"></div>
            <div class="ig-edit-content-area">
                <div class="ig-edit-user-info">
                    <img src="@(ViewBag.ActiveUser != null && !string.IsNullOrEmpty(ViewBag.ActiveUser.ProfilePicturePath) ? ViewBag.ActiveUser.ProfilePicturePath : "https://cdn-icons-png.flaticon.com/512/149/149071.png")" alt="Avatar" />
                    <span>@currentUsername</span>
                </div>
                <form asp-action="CreatePost" method="post" enctype="multipart/form-data" id="realEditForm" style="display:flex; flex-direction:column; flex:1;">
                    <input type="hidden" id="editPostId" name="editPostId" value="" />
                    <input type="hidden" id="existingMediaUrl" name="existingMediaUrl" value="" />
                    <textarea name="content" id="postContentAreaModal" class="ig-edit-textarea" placeholder="Açıklama yaz..."></textarea>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="ig-layout">
    <nav class="ig-sidebar">
        <div class="ig-logo-area"><i class="fa-solid fa-globe ig-logo-icon"></i></div>
        <ul class="ig-nav-list">
            <li><a href="/Home/Index" class="ig-nav-item active"><i class="fa-solid fa-house"></i> <span class="ig-nav-label">Ana Sayfa</span></a></li>
            <li><a href="#" class="ig-nav-item"><i class="fa-solid fa-compass"></i> <span class="ig-nav-label">Keşfet</span></a></li>
            <li>
                <button type="button" class="ig-nav-item" onclick="toggleSearchModal(event)" style="background:none; border:none; width:100%; text-align:left; cursor:pointer; padding: 12px 10px; color: inherit; font: inherit; display:flex; align-items:center; gap:16px;">
                    <i class="fa-solid fa-magnifying-glass"></i> <span class="ig-nav-label">Ara</span>
                </button>
            </li>
            <li>
                <button type="button" class="ig-nav-item" onclick="toggleMessagePopup(event)" style="background:none; border:none; width:100%; text-align:left; cursor:pointer; padding: 12px 10px; color: inherit; font: inherit; display:flex; align-items:center; gap:16px; position:relative;">
                    <i class="fa-regular fa-paper-plane"></i>
                    <span class="ig-nav-label">Mesajlar</span>
                    <span id="sidebarUnreadBadge" class="ig-sidebar-badge" style="display:none;">0</span>
                </button>
            </li>
            <li><a href="#" class="ig-nav-item"><i class="fa-solid fa-clapperboard"></i> <span class="ig-nav-label">Reels</span></a></li>
            <li><a href="#" class="ig-nav-item"><i class="fa-regular fa-heart"></i> <span class="ig-nav-label">Bildirimler</span></a></li>
            <li><a href="/Home/Profile/@currentUsername" class="ig-nav-item"><img src="@(ViewBag.ActiveUser != null && !string.IsNullOrEmpty(ViewBag.ActiveUser.ProfilePicturePath) ? ViewBag.ActiveUser.ProfilePicturePath : "https://cdn-icons-png.flaticon.com/512/149/149071.png")" class="ig-nav-avatar" /> <span class="ig-nav-label">Profil</span></a></li>
        </ul>
        <div class="ig-sidebar-bottom">
            <button type="button" class="ig-bottom-item" onclick="toggleTheme()">
                <i class="fa-solid fa-moon" id="themeIcon"></i>
                <span class="ig-nav-label" id="themeText">Tema: Koyu</span>
            </button>
            <button type="button" class="ig-bottom-item" onclick="openLogoutModal()">
                <i class="fa-solid fa-right-from-bracket"></i>
                <span class="ig-nav-label">Çıkış Yap</span>
            </button>
        </div>
    </nav>

    <main class="ig-feed">
        <div class="ig-stories-box">
            @{
                DateTime expireLimit = DateTime.Now.AddHours(-24);
                var activeStoriesList = ViewBag.ActiveStories as List<Story> ?? new List<Story>();
                var myStories = activeStoriesList.Where(s => s.Username.ToLower() == currentUsername.ToLower()).OrderBy(s => s.DateCreated).ToList();
                bool hasMyStory = myStories.Any();

                var seenList = ViewBag.SeenStoryIds as List<int> ?? new List<int>();

                bool isMyStoryAllSeen = hasMyStory && myStories.All(s => seenList.Contains(s.Id));
                string myRingClass = hasMyStory ? (isMyStoryAllSeen ? "seen-story" : "has-story") : "";
            }

<div class="ig-story-item">
    <div class="ig-story-ring-wrapper" style="position: relative; display: inline-block; width: 66px; height: 66px;">
        <div class="ig-story-ring @myRingClass" id="ring-my-story" onclick="openUserStories('@currentUsername')" style="width: 66px; height: 66px; border-radius: 50%; display: flex; align-items: center; justify-content: center; position: relative; cursor: pointer;">
            <div class="ig-story-avatar" style="width: 60px; height: 60px; border-radius: 50%; overflow: hidden;">
                <img src="@(ViewBag.ActiveUser != null && !string.IsNullOrEmpty(ViewBag.ActiveUser.ProfilePicturePath) ? ViewBag.ActiveUser.ProfilePicturePath : "https://cdn-icons-png.flaticon.com/512/149/149071.png")" alt="Hikayen" style="width: 100%; height: 100%; object-fit: cover;" />
            </div>
            <div onclick="event.stopPropagation(); document.getElementById('storyCreateModal').style.display = 'flex';" title="Hikaye Ekle" style="position: absolute; bottom: -2px; right: -2px; background: #0095f6; color: white; width: 22px; height: 22px; border-radius: 50%; border: 2px solid #dbdbdb; display: flex; align-items: center; justify-content: center; font-size: 11px; font-weight: bold; cursor: pointer; z-index: 99;">
                <i class="fa-solid fa-plus"></i>
            </div>
        </div>
    </div>
    <span class="ig-story-name">Hikayen</span>
</div>
            @if (activeStoriesList != null)
            {
                var otherStoriesGroup = activeStoriesList.Where(s => s.Username.ToLower() != currentUsername.ToLower()).GroupBy(s => s.Username);

                foreach (var group in otherStoriesGroup)
                {
                    var ownerUser = _context.Users.FirstOrDefault(u => u.Username.ToLower() == group.Key.ToLower());
                    string storyUserPic = (ownerUser != null && !string.IsNullOrEmpty(ownerUser.ProfilePicturePath)) ? ownerUser.ProfilePicturePath : "https://cdn-icons-png.flaticon.com/512/149/149071.png";

                    var userStoryList = group.OrderBy(s => s.DateCreated).ToList();

                    bool isAllSeen = userStoryList.All(s => seenList.Contains(s.Id));
                    string ringClass = isAllSeen ? "seen-story" : "has-story";

                    <div class="ig-story-item" onclick="openUserStories('@group.Key')">
                        <div class="ig-story-ring-wrapper">
                            <div class="ig-story-ring @ringClass">
                                <div class="ig-story-avatar"><img src="@storyUserPic" alt="@group.Key" /></div>
                            </div>
                        </div>
                        <span class="ig-story-name">@group.Key</span>
                    </div>
                }
            }
        </div>

        <div class="ig-create-card" id="postCreateCard">
            <form asp-action="CreatePost" method="post" enctype="multipart/form-data">
                <textarea name="content" id="postContentArea" class="ig-textarea" placeholder="Ne düşünüyorsun, @currentUsername?" rows="2" required></textarea>
                <div id="mediaPreviewContainer" class="ig-preview-box" style="display: none;">
                    <div id="previewWrapper"></div>
                    <button type="button" id="removeMediaBtn" class="ig-remove-media-btn" title="Medyayı Kaldır">✕</button>
                </div>
                <div class="ig-create-actions">
                    <label for="postMediaInput" class="ig-media-label"><i class="fa-solid fa-photo-film"></i> Fotoğraf / Video</label>
                    <input type="file" id="postMediaInput" name="postMedia" accept="image/*,video/*" style="display: none;" onchange="handlePostMediaSelect(event)" />
                    <button type="submit" id="submitPostBtn" class="ig-share-btn">Paylaş</button>
                </div>
            </form>
        </div>

        @foreach (var post in Model)
        {
            var fark = DateTime.Now - post.Date;
            string zamanfarkı = fark.TotalMinutes < 1 ? "Az önce" : fark.TotalHours < 1 ? $"{(int)fark.TotalMinutes}d önce" : fark.TotalDays < 1 ? $"{(int)fark.TotalHours}s önce" : $"{(int)fark.TotalDays}g önce";
            bool isLikedByMe = post.Likes.Any(l => l.Username == currentUsername);
            int likeCount = post.Likes.Count;
            int commentCount = post.Comments.Count;

            <div class="ig-post-card" id="post-card-@post.Id">
                <div class="ig-post-header">
                    <div class="ig-post-user-info">
                        <div class="ig-post-avatar">
                            <a href="/Home/Profile/@post.Username">
                                @{
                                    var postOwner = _context.Users.FirstOrDefault(u => u.Username.ToLower() == post.Username.ToLower());
                                    string ownerPic = (postOwner != null && !string.IsNullOrEmpty(postOwner.ProfilePicturePath)) ? postOwner.ProfilePicturePath : "https://cdn-icons-png.flaticon.com/512/149/149071.png";
                                }
                                <img src="@ownerPic" alt="Avatar" />
                            </a>
                        </div>
                        <div>
                            <a href="/Home/Profile/@post.Username" class="ig-post-username" style="text-decoration:none;">@post.Username</a>
                            <span class="ig-post-time">@zamanfarkı</span>
                        </div>
                    </div>
                    <div class="ig-dropdown-wrapper">
                        <button type="button" class="ig-dots-btn" onclick="toggleMenu(event, '@post.Id')"><span></span><span></span><span></span></button>
                        <div id="menu-@post.Id" class="ig-dropdown-menu">
                            @if (post.Username == currentUsername)
                            {
                                <button type="button" class="ig-dropdown-item edit" onclick="prepareEditPostFromData(this)" data-id="@post.Id" data-content="@post.Content" data-media="@post.MediaUrl">Düzenle</button>
                                <a href="/Home/DeletePost/@post.Id" class="ig-dropdown-item delete">Sil</a>
                            }
                            else
                            {
                                <a href="#" class="ig-dropdown-item" onclick="alert('Şikayet edildi.')">Şikayet Et</a>
                            }
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(post.MediaUrl))
                {
                    <div class="ig-post-media">
                        @if (post.MediaType == "video")
                        {
                            <video controls autoplay muted loop><source src="@post.MediaUrl" type="video/mp4"></video>
                        }
                        else
                        {
                            <img src="@post.MediaUrl" alt="Gönderi Medyası" />
                        }
                    </div>
                }

                <div class="ig-post-actions-bar">
                    <div class="ig-action-group">
                        <button type="button" class="ig-action-icon-btn" onclick="toggleLike('@post.Id')">
                            <i class="@(isLikedByMe ? "fa-solid fa-heart liked" : "fa-regular fa-heart")" id="heart-icon-@post.Id"></i>
                        </button>
                        <span id="like-count-@post.Id" class="ig-action-count" style="display: @(likeCount > 0 ? "inline" : "none");">@likeCount</span>
                    </div>
                    <div class="ig-action-group">
                        <button type="button" class="ig-action-icon-btn" onclick="toggleCommentBox('@post.Id')">
                            <i class="fa-regular fa-comment"></i>
                        </button>
                        <span id="comment-count-@post.Id" class="ig-action-count" style="display: @(commentCount > 0 ? "inline" : "none");">@commentCount</span>
                    </div>
                    <button type="button" class="ig-action-icon-btn"><i class="fa-regular fa-paper-plane"></i></button>
                </div>

                @if (!string.IsNullOrWhiteSpace(post.Content))
                {
                    <div class="ig-post-body">
                        <a href="/Home/Profile/@post.Username" class="ig-post-user-inline" style="text-decoration:none;">@post.Username</a>
                        <span class="ig-post-text">@post.Content</span>
                    </div>
                }

             <div id="comment-box-@post.Id" class="ig-comment-section" style="display: none;">
    <div class="ig-comment-list">
        @if (!post.Comments.Any())
        {
            <span class="ig-no-comment">Henüz yorum yok. İlk yorumu sen yaz!</span>
        }
        else
        {
            @foreach (var comment in post.Comments)
            {
                <div class="ig-comment-row" id="comment-row-@comment.Id">
                    <div class="ig-comment-content-area" style="display: flex; align-items: center; gap: 8px; width: 100%;">
                        <img src="@(string.IsNullOrEmpty(comment.UserProfilePicture) ? "https://cdn-icons-png.flaticon.com/512/149/149071.png" : comment.UserProfilePicture)" alt="Avatar" class="ig-comment-avatar" style="width:28px; height:28px; border-radius:50%; object-fit:cover;" />
                        <div style="flex: 1; word-break: break-word;">
                            <a href="/Home/Profile/@comment.Username" style="text-decoration:none;"><strong class="ig-comment-user">@comment.Username</strong></a>
                            <span class="ig-comment-text">@comment.Content</span>
                        </div>
                    </div>
                    @if (comment.Username == currentUsername)
                    {
                        <div style="position: relative;">
                            <button type="button" class="ig-comment-dots" onclick="toggleCommentMenu(event, '@comment.Id')"><span></span><span></span><span></span></button>
                            <div id="comment-menu-@comment.Id" class="ig-comment-popup-panel">
                                <button type="button" class="ig-panel-btn delete" onclick="deleteCommentAjax('@comment.Id')" style="width:100% !important; justify-content:center; background:none; border:none; cursor:pointer;">
                                    <i class="fa-solid fa-trash"></i> Sil
                                </button>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
    <form onsubmit="submitCommentAjax(event, '@post.Id')" class="ig-comment-form">
        <input type="text" id="comment-input-@post.Id" class="ig-comment-input" placeholder="Yorum ekle..." autocomplete="off" spellcheck="false" required />
        <button type="submit" class="ig-comment-submit">Paylaş</button>
    </form>
</div>
            </div>
        }
    </main>

    <aside class="ig-sidebar-right">
        <div class="ig-profile-box">
            <div class="ig-profile-avatar-lg">
                <img src="@(ViewBag.ActiveUser != null && !string.IsNullOrEmpty(ViewBag.ActiveUser.ProfilePicturePath) ? ViewBag.ActiveUser.ProfilePicturePath : "https://cdn-icons-png.flaticon.com/512/149/149071.png")" alt="Profil" />
            </div>
            <div class="ig-profile-info">
                <span class="ig-profile-name">@currentUsername</span>
                <span class="ig-profile-sub">@(ViewBag.ActiveUser != null ? ViewBag.ActiveUser.Bio : "Aktif Kullanıcı")</span>
            </div>
            <a href="#" class="ig-switch-link">Geçiş Yap</a>
        </div>
        <div class="ig-suggestions-header">
            <span class="ig-sug-title">Senin için önerilenler</span>
            <a href="#" class="ig-sug-all">Tümünü gör</a>
        </div>
        <div class="ig-footer-links">
            <a href="#">Hakkında</a> • <a href="#">Yardım</a> • <a href="#">Basın</a> • <a href="#">Gizlilik</a> • <a href="#">Koşullar</a>
            <div class="ig-meta-copyright">© 2026 SOSYAL MEDYA FROM META</div>
        </div>
    </aside>
</div>

<!-- HİKAYE OYNATICISI -->
<div id="storyViewerModal" class="ig-story-viewer-modal" onclick="closeStoryViewer()" style="display: none;">
    <div class="ig-story-backdrop-blur"></div>
    <div class="ig-story-top-bar" onclick="event.stopPropagation()">
        <div class="ig-story-progress-container" id="storyProgressContainer"></div>
        <div class="ig-story-header-info">
            <img id="viewerOwnerPic" src="" class="ig-viewer-avatar" />
            <span id="viewerOwnerName" class="ig-viewer-username"></span>
            <span id="viewerTimeAgo" class="ig-viewer-time"></span>
        </div>
        <div class="ig-story-header-right">
            <div class="ig-story-menu-wrapper">
                <button type="button" class="ig-story-dots-btn" onclick="toggleStoryMenu(event)"><span></span><span></span><span></span></button>
                <div id="storyDropdownMenu" class="ig-story-dropdown" style="display:none;">
                    <a id="deleteStoryLink" href="#" class="ig-story-delete-item" onclick="handleStoryDelete(event)">Hikayeyi Sil</a>
                </div>
            </div>
            <button type="button" class="ig-story-close-global" onclick="closeStoryViewer()">✕</button>
        </div>
    </div>
    <div class="ig-story-viewer-container" onclick="event.stopPropagation()">
        <div class="ig-main-story-card">
            <div class="ig-story-media-box" id="viewerMediaContainer"
                 onmousedown="startStoryHold(event)" onmouseup="endStoryHold(event)" onmouseleave="endStoryHold(event)"
                 onttouchstart="startStoryHold(event)" ontouchend="endStoryHold(event)" onclick="handleStoryCardClick(event)">
            </div>
            <div class="ig-story-footer-actions">
                <input type="text" id="storyCommentInput" placeholder="Yanıt gönder..." autocomplete="off" spellcheck="false" onkeypress="handleStoryComment(event)" />
                <button type="button" class="ig-story-like-btn" onclick="likeActiveStory()"><i class="fa-regular fa-heart" id="storyHeartIcon"></i></button>
                <button type="button" class="ig-story-send-btn" onclick="sendStoryComment()"><i class="fa-regular fa-paper-plane"></i></button>
            </div>
        </div>
    </div>
</div>

<!-- ÇIKIŞ ONAY MODALI -->
<div id="logoutModal" class="ig-logout-modal-overlay" style="display: none;" onclick="closeLogoutModalOnOutside(event)">
    <div class="ig-logout-modal-box">
        <div class="ig-logout-modal-header">
            <h3>Çıkış Yap</h3>
            <p>Hesabınızdan çıkış yapmak istediğinize emin misiniz?</p>
        </div>
        <div class="ig-logout-modal-actions">
            <a href="/Account/Logout" class="ig-logout-confirm-btn">Çıkış Yap</a>
            <button type="button" class="ig-logout-cancel-btn" onclick="closeLogoutModal()">İptal</button>
        </div>
    </div>
</div>

<!-- MESAJLAR KUTUSU -->
<div id="igMessagePopup" class="ig-msg-popup-container" style="display: none;" onclick="event.stopPropagation()">
    <div class="ig-msg-popup-header">
        <div class="ig-msg-popup-title-area" id="popupTitleArea">
            <h3 id="popupTitle">Mesajlar</h3>
            <span class="ig-msg-badge" id="totalUnreadBadge" style="display:none;">0</span>
        </div>
        <div class="ig-msg-popup-controls">
            <button type="button" id="chatBackBtn" class="ig-msg-control-btn" onclick="backToMessageList()" style="display:none;" title="Geri">
                <i class="fa-solid fa-arrow-left"></i>
            </button>
            <a href="/Home/Messages" class="ig-msg-control-btn mobile-hide-control" title="Tam Ekrana Geç">
                <i class="fa-solid fa-expand"></i>
            </a>
            <button type="button" class="ig-msg-control-btn mobile-hide-control" onclick="toggleMessagePopup()" title="Kapat">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    </div>

    <div class="ig-msg-search-box" id="msgSearchBoxContainer">
        <div class="ig-search-input-wrapper">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input type="text" id="msgSearchInput" placeholder="Ara..." oninput="handleMsgSearchInput(this.value)" autocomplete="off" spellcheck="false" />
            <button type="button" id="msgSearchClearBtn" class="ig-search-clear-btn" onclick="clearMsgSearch()" title="Temizle">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    </div>

    <div class="ig-msg-popup-body" id="igMsgPopupContentArea"></div>

    <div class="ig-msg-popup-footer" id="igMsgFooter">
        <button type="button" class="ig-msg-new-btn" onclick="switchToNewMessageView()" title="Yeni Mesaj Oluştur">
            <i class="fa-regular fa-pen-to-square"></i>
        </button>
    </div>
</div>

<style>
    :root {
        --ig-bg: #000;
        --ig-card-bg: #000;
        --ig-text: #fff;
        --ig-text-muted: #737373;
        --ig-border: #262626;
        --ig-input-bg: #121212;
        --ig-hover: rgba(255, 255, 255, 0.05);
        --ig-primary: #0095f6;
    }

    html, body {
        background-color: var(--ig-bg);
        color: var(--ig-text);
