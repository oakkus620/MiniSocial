        object-fit: cover !important;
        min-width: 24px !important;
    }

    .ig-nav-label {
        opacity: 0;
        transition: opacity 0.2s;
    }

    .ig-messages-wrapper .ig-sidebar:hover .ig-nav-label {
        opacity: 1;
    }

    .ig-sidebar-bottom {
        display: flex;
        flex-direction: column;
        gap: 6px;
        white-space: nowrap;
    }

    .ig-bottom-item {
        background: none;
        border: none;
        width: 100%;
        text-align: left;
    }

    .ig-bottom-item:hover {
        background-color: var(--ig-hover);
    }

    .ig-dm-container {
        flex: 1;
        margin-left: 72px;
        height: 100vh;
        display: flex;
        background: var(--ig-bg);
        box-sizing: border-box;
