        font-weight: 400;
        margin: 0;
        color: var(--ig-text);
    }

    .ig-dm-empty-state p {
        font-size: 14px;
        color: var(--ig-text-muted);
        margin: 0 0 16px 0;
    }

    .ig-send-message-action-btn {
        background: var(--ig-primary);
        color: white;
        border: none;
        padding: 8px 16px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
    }

    .ig-active-dm-box {
        display: flex;
        flex-direction: column;
        height: 100vh;
        box-sizing: border-box;
        position: relative;
    }

    .ig-active-dm-header {
        padding: 14px 24px;
        background: color-mix(in srgb, var(--ig-card-bg) 95%, #888888 5%);
        border-bottom: 1px solid var(--ig-border);
        display: flex;
        align-items: center;
        justify-content: space-between;
        box-shadow: 0 1px 2px rgba(0,0,0,0.03);
    }

    .ig-active-dm-user-info {
        display: flex;
        align-items: center;
        gap: 12px;
