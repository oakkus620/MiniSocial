@inject NewProject.Data.AppDbContext _context
@{
    ViewData["Title"] = "Sohbetler • Mesajlar";
    string currentUsername = Context.Session.GetString("GirisYapanKullanici") ?? string.Empty;
}

<!-- YENİ MESAJ OLUŞTURMA MODALI -->
<div id="newChatModal" class="ig-custom-modal-overlay" style="display: none;" onclick="closeNewChatModalOnOutside(event)">
    <div class="ig-custom-modal-box" onclick="event.stopPropagation()">
        <div class="ig-custom-modal-header">
            <h3>Yeni Mesaj</h3>
            <button type="button" onclick="toggleNewChatModal()" class="ig-custom-close-btn">✕</button>
        </div>
        <div class="ig-custom-input-wrapper">
            <i class="fa-solid fa-magnifying-glass" style="color:var(--ig-text-muted);"></i>
            <input type="text" id="newChatSearchInput" class="ig-custom-search-input" placeholder="Kişi ara (Kullanıcı adı)..." oninput="searchUsersForNewChat(this.value)" autocomplete="off" spellcheck="false" autofocus />
        </div>
        <div class="ig-custom-modal-results" id="newChatSearchResults">
            <div class="ig-search-placeholder">Mesaj göndermek istediğiniz kişiyi arayın...</div>
        </div>
    </div>
</div>

<div class="ig-messages-wrapper">
    <!-- SOL İKON MENÜSÜ -->
    <nav class="ig-sidebar">
        <div class="ig-logo-area"><i class="fa-solid fa-globe ig-logo-icon"></i></div>
        <ul class="ig-nav-list">
            <li><a href="/Home/Index" class="ig-nav-item"><i class="fa-solid fa-house"></i> <span class="ig-nav-label">Ana Sayfa</span></a></li>
            <li><a href="#" class="ig-nav-item"><i class="fa-solid fa-compass"></i> <span class="ig-nav-label">Keşfet</span></a></li>
            <li>
                <button type="button" class="ig-nav-item" onclick="toggleSearchModal(event)" style="background:none; border:none; width:100%; text-align:left; cursor:pointer; padding: 12px 10px; color: inherit; font: inherit; display:flex; align-items:center; gap:16px;">
                    <i class="fa-solid fa-magnifying-glass"></i> <span class="ig-nav-label">Ara</span>
                </button>
            </li>
            <li><a href="/Home/Messages" class="ig-nav-item active"><i class="fa-regular fa-paper-plane"></i> <span class="ig-nav-label">Mesajlar</span></a></li>
            <li><a href="#" class="ig-nav-item"><i class="fa-solid fa-clapperboard"></i> <span class="ig-nav-label">Reels</span></a></li>
            <li><a href="#" class="ig-nav-item"><i class="fa-regular fa-heart"></i> <span class="ig-nav-label">Bildirimler</span></a></li>
            <li><a href="/Home/Profile/@currentUsername" class="ig-nav-item"><img src="@(ViewBag.ActiveUser != null && !string.IsNullOrEmpty(ViewBag.ActiveUser.ProfilePicturePath) ? ViewBag.ActiveUser.ProfilePicturePath : "https://cdn-icons-png.flaticon.com/512/149/149071.png")" class="ig-nav-avatar" /> <span class="ig-nav-label">Profil</span></a></li>
        </ul>
        <div class="ig-sidebar-bottom">
            <button type="button" class="ig-bottom-item" onclick="toggleTheme()">
                <i class="fa-solid fa-moon" id="themeIcon"></i>
                <span class="ig-nav-label" id="themeText">Tema: Koyu</span>
            </button>
            <button type="button" class="ig-bottom-item" onclick="openLogoutModal()">
                <i class="fa-solid fa-right-from-bracket"></i>
                <span class="ig-nav-label">Çıkış Yap</span>
            </button>
        </div>
    </nav>

    <!-- ANA DM ALANI -->
    <main class="ig-dm-container">
        <!-- SOL SOHBET LİSTESİ PANELİ -->
        <section class="ig-dm-sidebar">
            <div class="ig-dm-sidebar-header">
                <div class="ig-dm-username-dropdown">
                    <span>@currentUsername</span>
                    <i class="fa-solid fa-chevron-down" style="font-size: 11px;"></i>
                </div>
                <button type="button" class="ig-dm-new-chat-btn" onclick="toggleNewChatModal()" title="Yeni Mesaj"><i class="fa-regular fa-pen-to-square"></i></button>
            </div>

            <!-- SOHBETLER ARASINDA ARAMA ÇUBUĞU -->
            <div class="ig-dm-search-box" style="padding: 0 24px 12px 24px;">
                <div style="display: flex; align-items: center; background: var(--ig-input-bg); border-radius: 10px; padding: 8px 12px; gap: 10px;">
                    <i class="fa-solid fa-magnifying-glass" style="color: var(--ig-text-muted); font-size: 14px;"></i>
                    <input type="text" id="dmSearchInput" placeholder="Ara..." oninput="filterConversations(this.value)" autocomplete="off" spellcheck="false" style="background: none; border: none; outline: none; color: var(--ig-text); font-size: 13px; width: 100%;" />
                </div>
            </div>

            <div class="ig-dm-nav-tabs">
                <button type="button" class="active">Mesajlar</button>
                <button type="button">İstekler</button>
            </div>
            <div class="ig-dm-conversations-list" id="fullScreenChatList">
                <!-- Dinamik sohbet listesi -->
            </div>
        </section>

        <!-- SAĞ GENİŞ SOHBET ALANI -->
        <section class="ig-dm-chat-area" id="fullScreenChatArea">
            <div class="ig-dm-empty-state">
                <div class="ig-empty-plane-icon">
                    <i class="fa-regular fa-paper-plane"></i>
                </div>
                <h2>Mesajların</h2>
                <p>Bir arkadaşına veya gruba özel fotoğraflar ve mesajlar gönder.</p>
                <button type="button" class="ig-send-message-action-btn" onclick="toggleNewChatModal()">Mesaj gönder</button>
            </div>
        </section>
    </main>
</div>

<style>
    .ig-messages-wrapper {
        display: flex;
        width: 100vw;
        height: 100vh;
        overflow: hidden;
        background-color: var(--ig-bg);
        color: var(--ig-text);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        margin: 0;
        padding: 0;
        position: fixed;
        top: 0;
        left: 0;
    }

    .ig-messages-wrapper .ig-sidebar {
        width: 72px;
        height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
        border-right: 1px solid var(--ig-border);
        padding: 24px 12px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        background: var(--ig-card-bg);
        z-index: 1000;
        box-sizing: border-box;
        transition: width 0.25s ease;
        overflow: hidden;
    }

    .ig-messages-wrapper .ig-sidebar:hover {
        width: 244px;
    }

    .ig-logo-area {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 12px 4px 28px 8px;
    }

    .ig-logo-icon {
        font-size: 26px;
        color: var(--ig-primary);
        min-width: 24px;
        text-align: center;
    }

    .ig-nav-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .ig-nav-item, .ig-bottom-item {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 12px 10px;
        text-decoration: none;
        color: var(--ig-text);
        border-radius: 8px;
        font-size: 15px;
        white-space: nowrap;
        cursor: pointer;
        box-sizing: border-box;
    }

    .ig-nav-item i, .ig-bottom-item i {
        font-size: 20px !important;
        width: 24px;
        text-align: center;
        display: inline-block;
        flex-shrink: 0;
    }

    .ig-nav-item:hover, .ig-nav-item.active {
        background-color: var(--ig-hover);
        font-weight: 600;
    }

    .ig-nav-avatar {
        width: 24px !important;
        height: 24px !important;
