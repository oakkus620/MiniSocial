        height: 44px;
        border-radius: 50%;
        object-fit: cover;
    }

    .ig-active-dm-messages-body {
        flex: 1;
        padding: 24px;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .ig-active-dm-input-box {
        padding: 16px 24px 24px 24px;
        background: var(--ig-card-bg);
    }

    .ig-active-dm-input-wrapper {
        display: flex;
        align-items: center;
        background: var(--ig-input-bg);
        border: 1px solid var(--ig-border);
        border-radius: 24px;
        padding: 10px 16px;
        gap: 14px;
    }

    .ig-active-dm-input {
        flex: 1;
        background: none;
        border: none;
        outline: none;
        color: var(--ig-text);
        font-size: 14px;
    }

    .ig-active-dm-send-btn {
        background: none;
        border: none;
        color: #0095f6;
        font-weight: 600;
        font-size: 14px;
        cursor: pointer;
        padding: 0 4px;
    }

    .ig-active-dm-send-btn:hover {
        opacity: 0.8;
    }

    .ig-custom-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 9999999;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(0,0,0,0.6);
        backdrop-filter: blur(4px);
    }

    .ig-custom-modal-box {
        width: 480px;
        max-width: 90vw;
        height: 450px;
        background: #262626;
        border: 1px solid var(--ig-border);
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        padding: 20px;
        box-sizing: border-box;
    }

    .ig-custom-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #363636;
        padding-bottom: 14px;
        margin-bottom: 16px;
    }

    .ig-custom-modal-header h3 {
        font-size: 16px;
        font-weight: 600;
