<script>
    function toggleSearchModal(event) {
        if (event) event.preventDefault();
        const modal = document.getElementById('searchModalOverlay');
        if (!modal) return;
        modal.style.display = modal.style.display === 'flex' ? 'none' : 'flex';
        if (modal.style.display === 'flex') document.getElementById('searchInput').focus();
    }
    function closeSearchModalOnOutside(event) {
        const modal = document.getElementById('searchModalOverlay');
        if (event.target === modal) modal.style.display = 'none';
    }
    function closeStoryCreateModal(e) {
        if (!e || e.target.id === 'storyCreateModal' || e.target.classList.contains('ig-search-close-btn')) {
            document.getElementById('storyCreateModal').style.display = 'none';
        }
    }
    function searchUsersAjax(query) {
        const container = document.getElementById('searchResultsContainer');
        if (!query || query.trim() === "") { container.innerHTML = '<div class="ig-search-placeholder">Aramak için bir şeyler yazın...</div>'; return; }
        fetch('/Home/SearchUsers?q=' + encodeURIComponent(query)).then(res => res.json()).then(users => {
            if (users.length === 0) { container.innerHTML = '<div class="ig-search-placeholder">Sonuç bulunamadı.</div>'; return; }
            let html = '';
            users.forEach(u => {
                html += `<a href="/Home/UserProfile/${encodeURIComponent(u.username)}" class="ig-search-result-item"><div class="ig-search-user-info"><img src="${u.profilePicture}" class="ig-search-avatar" /><div><span class="ig-search-username">${u.username}</span><span class="ig-search-bio">${u.bio}</span></div></div></a>`;
            });
            container.innerHTML = html;
        });
    }

    function toggleFollow(targetUsername) {
    fetch('/Home/ToggleFollowRequest?targetUsername=' + encodeURIComponent(targetUsername), { 
        method: 'POST', 
        headers: { 'Content-Type': 'application/json' } 
    })
    .then(res => res.json())
    .then(data => {
        if (data.success) {
            const btn = document.getElementById('followBtn');
            const countSpan = document.getElementById('followerCountDisplay');

            if (data.status === "following") {
                btn.textContent = "Takipten Çık";
                btn.className = "ig-follow-main-btn following";
            } else if (data.status === "unfollowed") {
                btn.textContent = "Takip Et";
                btn.className = "ig-follow-main-btn";
            } else if (data.status === "pending") {
                btn.textContent = "İstek Gönderildi";
                btn.className = "ig-follow-main-btn pending";
            } else if (data.status === "cancelled") {
                btn.textContent = "Takip Et";
                btn.className = "ig-follow-main-btn";
            }
            
            if (data.followerCount !== undefined && countSpan) {
                countSpan.textContent = data.followerCount;
            }
        }
    });
}

    let currentStories = [];
    let currentStoryIndex = 0;
    let storyTimer = null;
    let progressInterval = null;
    let isPaused = false;
    const sessionUser = "@currentUsername";

    function openUserStories(username) {
        fetch('/Home/GetUserStories?username=' + encodeURIComponent(username)).then(res => res.json()).then(stories => {
            if (stories && stories.length > 0) {
                currentStories = stories;
                const firstUnseenIdx = stories.findIndex(s => {
                    const seen = s.IsSeenByMe !== undefined ? s.IsSeenByMe : s.isSeenByMe;
                    return !seen;
                });
                currentStoryIndex = firstUnseenIdx !== -1 ? firstUnseenIdx : 0;
                document.getElementById('storyViewerModal').style.display = 'flex';
                buildProgressSegments();
                loadStoryByIndex(currentStoryIndex);
            }
        });
    }

    function buildProgressSegments() {
        const container = document.getElementById('storyProgressContainer');
        if (!container) return;
        container.innerHTML = '';
        currentStories.forEach((s, idx) => {
            const seg = document.createElement('div');
            seg.className = 'ig-story-progress-segment';
            seg.innerHTML = `<div class="ig-story-progress-fill" id="seg-fill-${idx}"></div>`;
            container.appendChild(seg);
        });
    }

    function loadStoryByIndex(index) {
        if (index < 0 || index >= currentStories.length) { closeStoryViewer(); return; }
        currentStoryIndex = index;
        const story = currentStories[index];

        const storyId = story.Id || story.id;
        const storyUsername = story.Username || story.username;
        const storyMediaUrl = story.MediaUrl || story.mediaUrl;
        const storyMediaType = story.MediaType || story.mediaType;
        const userPic = story.UserProfilePic || story.userProfilePic || "https://cdn-icons-png.flaticon.com/512/149/149071.png";
        const storyDate = story.Date || story.date;
        const isLiked = story.IsLikedByMe !== undefined ? story.IsLikedByMe : (story.isLikedByMe !== undefined ? story.isLikedByMe : false);

        if (storyId) {
            fetch('/Home/InteractStory?storyId=' + storyId + '&type=seen', { method: 'POST' })
                .catch(err => console.error("Görüldü kaydedilemedi:", err));
        }

        document.getElementById('viewerOwnerName').textContent = storyUsername;
        document.getElementById('viewerOwnerPic').src = userPic;

        const diffMin = Math.floor((new Date() - new Date(storyDate)) / 60000);
        let timeStr = diffMin < 1 ? "Az önce" : diffMin < 60 ? `${diffMin}d` : Math.floor(diffMin / 60) < 24 ? `${Math.floor(diffMin / 60)}s` : `${Math.floor(diffMin / 1440)}g`;
        document.getElementById('viewerTimeAgo').textContent = timeStr;

        const heartIcon = document.getElementById('storyHeartIcon');
        if (heartIcon) {
            heartIcon.className = isLiked ? "fa-solid fa-heart liked" : "fa-regular fa-heart";
        }

        const deleteLink = document.getElementById('deleteStoryLink');
        if (deleteLink) {
            if (storyUsername.toLowerCase() === sessionUser.toLowerCase()) {
                deleteLink.style.display = 'block';
                deleteLink.setAttribute('data-story-id', storyId);
            } else { deleteLink.style.display = 'none'; }
        }

        const container = document.getElementById('viewerMediaContainer');
        if (container) {
            container.innerHTML = '';
            if (storyMediaUrl && (storyMediaUrl.endsWith('.mp4') || storyMediaType === 'video')) {
                const video = document.createElement('video');
                video.src = storyMediaUrl; video.autoplay = true; video.muted = false; video.controls = false;
                container.appendChild(video);
            } else if (storyMediaUrl) {
                const img = document.createElement('img');
                img.src = storyMediaUrl;
                container.appendChild(img);
            }
        }

        currentStories.forEach((_, i) => {
            const fill = document.getElementById(`seg-fill-${i}`);
            if (fill) {
                if (i < index) fill.style.width = '100%';
                else if (i > index) fill.style.width = '0%';
            }
        });

        startStoryTimer();
    }

    function startStoryTimer() {
        clearTimeout(storyTimer);
        clearInterval(progressInterval);
        const currentFill = document.getElementById(`seg-fill-${currentStoryIndex}`);
        if (!currentFill) return;

        let width = 0;
        currentFill.style.width = '0%';
        progressInterval = setInterval(() => {
            if (!isPaused) {
                width += 1;
                currentFill.style.width = width + '%';
                if (width >= 100) clearInterval(progressInterval);
            }
        }, 50);
        storyTimer = setTimeout(() => { loadStoryByIndex(currentStoryIndex + 1); }, 5000);
    }

    function startStoryHold(e) { isPaused = true; }
    function endStoryHold(e) { isPaused = false; }

    function closeStoryViewer() {
        clearTimeout(storyTimer);
        clearInterval(progressInterval);
        isPaused = false;
        document.getElementById('storyViewerModal').style.display = 'none';
        const container = document.getElementById('viewerMediaContainer');
        if (container) container.innerHTML = '';
        location.reload();
    }

    function toggleStoryMenu(event) {
        event.stopPropagation();
        const menu = document.getElementById('storyDropdownMenu');
        if (menu) menu.style.display = menu.style.display === 'block' ? 'none' : 'block';
    }

    window.addEventListener('click', () => {
        const menu = document.getElementById('storyDropdownMenu');
        if (menu) menu.style.display = 'none';
    });

    function handleStoryCardClick(e) {
        const mediaBox = document.getElementById('viewerMediaContainer');
        if (mediaBox) {
            const rect = mediaBox.getBoundingClientRect();
            const clickX = e.clientX - rect.left;
            if (clickX < rect.width / 2) {
                if (currentStoryIndex > 0) loadStoryByIndex(currentStoryIndex - 1);
            } else {
                if (currentStoryIndex + 1 < currentStories.length) loadStoryByIndex(currentStoryIndex + 1);
                else closeStoryViewer();
            }
        }
    }

    function likeActiveStory() {
        const story = currentStories[currentStoryIndex];
        if (!story) return;
        const storyId = story.Id || story.id;
        if (!storyId) return;

        fetch('/Home/InteractStory?storyId=' + storyId + '&type=like', { method: 'POST' }).then(res => res.json()).then(data => {
            if (data.success) {
                const icon = document.getElementById('storyHeartIcon');
                if (icon) {
                    if (data.isLiked) {
                        icon.className = "fa-solid fa-heart liked";
                        story.IsLikedByMe = true; story.isLikedByMe = true;
                    } else {
                        icon.className = "fa-regular fa-heart";
                        story.IsLikedByMe = false; story.isLikedByMe = false;
                    }
                }
            }
        });
    }

    function sendStoryComment() {
        const story = currentStories[currentStoryIndex];
        const input = document.getElementById('storyCommentInput');
        if (!input || !story) return;
        const storyId = story.Id || story.id;
        const text = input.value.trim();
        if (!text || !storyId) return;

        fetch('/Home/InteractStory?storyId=' + storyId + '&type=comment&commentText=' + encodeURIComponent(text), { method: 'POST' }).then(res => res.json()).then(data => {
            if (data.success) {
                input.value = "";
                alert("Yorumunuz gönderildi!");
            }
        });
    }

    function handleStoryComment(e) { if (e.key === 'Enter') { e.preventDefault(); sendStoryComment(); } }

    function handleStoryFileSelect(event) {
        const file = event.target.files[0];
        if (!file) return;
        const hiddenInput = document.getElementById('hiddenStoryFileInput');
        const dataTransfer = new DataTransfer();
        dataTransfer.items.add(file);
        hiddenInput.files = dataTransfer.files;

        const container = document.getElementById('storyPreviewMediaContainer');
        container.innerHTML = '';
        const fileURL = URL.createObjectURL(file);
        if (file.type.startsWith('video')) {
            const video = document.createElement('video');
            video.src = fileURL; video.controls = true; video.autoplay = true; video.muted = true;
            container.appendChild(video);
        } else {
            const img = document.createElement('img');
            img.src = fileURL;
            container.appendChild(img);
        }

        document.getElementById('storyCreateModal').style.display = 'none';
        document.getElementById('storyPreviewModal').style.display = 'flex';
    }

    function closeStoryPreview(e) {
        if (!e || e.target.id === 'storyPreviewModal' || e.target.classList.contains('ig-story-cancel-btn') || e.target.classList.contains('ig-search-close-btn')) {
            document.getElementById('storyPreviewModal').style.display = 'none';
            document.getElementById('hiddenStoryFileInput').value = '';
        }
    }

    const deleteStoryLink = document.getElementById('deleteStoryLink');
    if (deleteStoryLink) {
        deleteStoryLink.addEventListener('click', function(e) {
            e.preventDefault();
            const storyId = this.getAttribute('data-story-id');
            if (!storyId) return;
            fetch('/Home/DeleteStory/' + storyId, { method: 'POST' }).then(() => {
                closeStoryViewer();
                location.reload();
            });
        });
    }

    function openLogoutModal() { document.getElementById('logoutModal').style.display = 'flex'; }
    function closeLogoutModal() { document.getElementById('logoutModal').style.display = 'none'; }
    function closeLogoutModalOnOutside(event) {
        const modal = document.getElementById('logoutModal');
        if (event.target === modal) modal.style.display = 'none';
    }

    function toggleTheme() {
        const body = document.body;
        const themeIcon = document.getElementById('themeIcon');
        const themeText = document.getElementById('themeText');

        body.classList.toggle('light-theme');

        if (body.classList.contains('light-theme')) {
            localStorage.setItem('ig_theme', 'light');
            themeIcon.className = "fa-solid fa-sun";
            themeText.textContent = "Tema: Açık";
        } else {
            localStorage.setItem('ig_theme', 'dark');
            themeIcon.className = "fa-solid fa-moon";
            themeText.textContent = "Tema: Koyu";
        }
    }

    window.addEventListener('DOMContentLoaded', () => {
        const savedTheme = localStorage.getItem('ig_theme');
        if (savedTheme === 'light') {
            document.body.classList.add('light-theme');
            const themeIcon = document.getElementById('themeIcon');
            const themeText = document.getElementById('themeText');
            if (themeIcon) themeIcon.className = "fa-solid fa-sun";
            if (themeText) themeText.textContent = "Tema: Açık";
        }
    });

    function openEditModal() {
    document.getElementById('editProfileModal').style.display = 'flex';
}
function closeEditModal() {
    document.getElementById('editProfileModal').style.display = 'none';
}
function closeEditModalOnOutside(event) {
    const modal = document.getElementById('editProfileModal');
    if (event.target === modal) modal.style.display = 'none';
}

    function openFollowModal(username, type) {
        const modal = document.getElementById('followListModal');
        const title = document.getElementById('followModalTitle');
        const container = document.getElementById('followModalResults');

        title.textContent = type === 'followers' ? 'Takipçiler' : 'Takip Edilenler';
        container.innerHTML = '<div style="text-align:center; color:#737373; margin-top:40px;">Yükleniyor...</div>';
        modal.style.display = 'flex';

        const endpoint = type === 'followers' ? '/Home/GetFollowersList?username=' : '/Home/GetFollowingList?username=';

        fetch(endpoint + encodeURIComponent(username))
            .then(res => res.json())
            .then(users => {
                if (!users || users.length === 0) {
                    container.innerHTML = '<div style="text-align:center; color:#737373; margin-top:40px;">Kişi bulunamadı.</div>';
                    return;
                }
                let html = '';
                users.forEach(u => {
                    html += `
                        <a href="/Home/UserProfile/${encodeURIComponent(u.username)}" style="display: flex; align-items: center; justify-content: space-between; padding: 8px 10px; border-radius: 8px; text-decoration: none; color: inherit;" onmouseover="this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.background='transparent'">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <img src="${u.profilePicture}" style="width: 40px; height: 40px; border-radius: 50%; object-fit: cover;" />
                                <div>
                                    <span style="font-weight: 600; font-size: 13px; color: #fff; display: block;">${u.username}</span>
                                    <span style="font-size: 12px; color: #737373;">${u.bio}</span>
                                </div>
                            </div>
                        </a>`;
                });
                container.innerHTML = html;
            });
    }

    function closeFollowModal() {
        document.getElementById('followListModal').style.display = 'none';
    }

    function closeFollowModalOnOutside(event) {
        const modal = document.getElementById('followListModal');
        if (event.target === modal) modal.style.display = 'none';
    }


    function openPostModal(postId) {
    const modal = document.getElementById('postDetailModal');
    const box = document.getElementById('postModalContentBox');
    
    box.innerHTML = '<div style="padding: 60px; color: #737373; margin: auto;">Yükleniyor...</div>';
    modal.style.display = 'flex';

    // HomeController'da bu gönderinin detayını HTML olarak döndüren bir endpoint'e bağlanabilir
    // Veya basitçe ana sayfadaki post kartının yapısını buraya AJAX ile çekebiliriz.
    fetch('/Home/GetPostDetails?postId=' + postId)
        .then(res => res.text())
        .then(html => {
            box.innerHTML = html;
        });
}

function closePostModal() {
    document.getElementById('postDetailModal').style.display = 'none';
}

function closePostModalOnOutside(event) {
    const modal = document.getElementById('postDetailModal');
    if (event.target === modal) modal.style.display = 'none';
}

</script>